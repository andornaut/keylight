#!/usr/bin/env bash
set -euo pipefail
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
target=dist
kind=python
suite=$(mktemp -d "${TMPDIR:-/scratch}/package-contract.XXXXXXXX")
sed -n '/^publish_package() (/ , /^)/p' tests/container/check-stock > "${suite}/publisher.sh"
[[ -s ${suite}/publisher.sh ]]
cleanup_suite() { find -P "${suite}" -depth -delete; }
trap cleanup_suite EXIT
fingerprint() {
    find -P "${target}" -printf '%P %y %l\n'
    find -P "${target}" -type f -exec sha256sum {} +
}
for scenario in success empty extra symlink hardlink special old-symlink index head ignore-root ignore-entry parent copy-failure rename-failure signal-before signal-after late-target; do
    checkout=${suite}/${scenario}
    scratch=${checkout}/scratch
    mkdir -p "${scratch}/build-output" "${checkout}/${target}"
    cd -- "${checkout}"
    git init --quiet --initial-branch=main
    git config user.name Fixture
    git config user.email fixture@example.invalid
    git config core.hooksPath /dev/null
    printf '%s/\nscratch/\n' "${target}" > .gitignore
    git add .gitignore
    git commit --quiet --message fixture
    revision=$(git rev-parse HEAD)
    printf stale > "${target}/stale"
    if [[ ${kind} == python ]]; then
        printf wheel > scratch/build-output/package.whl
        printf source > scratch/build-output/package.tar.gz
    else
        printf gem > scratch/build-output/package.gem
    fi
    artifact=$(find scratch/build-output -type f -print -quit)
    fault=${scratch}/fault.sh
    : > "${fault}"
    case "${scenario}" in
        empty) find scratch/build-output -type f -delete ;;
        extra) printf extra > scratch/build-output/unexpected.txt ;;
        symlink) ln -s "${checkout}/${target}/stale" scratch/build-output/linked ;;
        hardlink) ln "${artifact}" scratch/build-output/linked ;;
        special) mkfifo scratch/build-output/fifo ;;
        old-symlink) ln -s "${checkout}/.gitignore" "${target}/linked" ;;
        index|head)
            mv .gitignore scratch/saved-ignore
            git add "${target}/stale"
            mv scratch/saved-ignore .gitignore
            if [[ ${scenario} == head ]]; then
                git commit --quiet --message tracked
                revision=$(git rev-parse HEAD)
                git rm --cached "${target}/stale" >/dev/null
            fi
            ;;
        ignore-root) printf '!%s/\n' "${target}" >> .gitignore ;;
        ignore-entry) printf '!%s/\n%s/*\n!%s/stale\n' "${target}" "${target}" "${target}" >> .gitignore ;;
        parent) ln -s "${checkout}" "${suite}/checkout-alias"; checkout=${suite}/checkout-alias ;;
        copy-failure) printf '%s\n' 'cp() { return 1; }' > "${fault}" ;;
        rename-failure|signal-before|signal-after|late-target)
            cat > "${fault}" <<'FAULT'
mv() {
    if [[ ${4:-} == ."${target}"-stage.* ]]; then
        case "${PUBLISH_FAULT}" in
            rename-failure) return 1 ;;
            signal-before) kill -TERM "${BASHPID}"; return 143 ;;
            signal-after) command mv "$@"; kill -TERM "${BASHPID}"; return 143 ;;
            late-target) mkdir "${target}"; printf peer > "${target}/peer" ;;
        esac
    fi
    command mv "$@"
}
FAULT
            ;;
    esac
    before=$(fingerprint)
    export checkout scratch revision PUBLISH_FAULT=${scenario}
    set +e
    bash -ec 'source "$1"; source "$2"; publish_package' fixture "${suite}/publisher.sh" "${fault}" > "${scratch}/result.log" 2>&1
    status=$?
    set -e
    if [[ ${scenario} == success ]]; then
        [[ ${status} == 0 && ! -e ${target}/stale ]]
        if [[ ${kind} == python ]]; then [[ -f ${target}/package.whl && -f ${target}/package.tar.gz ]]; else [[ -f ${target}/package.gem ]]; fi
    elif [[ ${scenario} == late-target ]]; then
        [[ ${status} == 125 && $(cat "${target}/peer") == peer ]]
        backup=$(find . -maxdepth 1 -name ".${target}-backup.*" -type d -print)
        [[ -n ${backup} && $(cat "${backup}/stale") == stale ]]
        [[ -z $(find . -maxdepth 1 -name ".${target}-stage.*" -print) ]]
    else
        [[ ${status} != 0 && $(fingerprint) == "${before}" ]]
        [[ -z $(find . -maxdepth 1 \( -name ".${target}-stage.*" -o -name ".${target}-backup.*" \) -print) ]]
    fi
    printf 'Package publisher %s passed\n' "${scenario}"
done
