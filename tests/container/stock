#!/usr/bin/env bash
# Private stock-image isolation functions for project-owned Make checks.
stock_library_path=${BASH_SOURCE[0]}
stock_library_hash=$(sha256sum "${stock_library_path}" | cut -d ' ' -f1)

stock_remove_container() {
    local container_id remaining
    if [[ -s ${cidfile} ]]; then
        container_id=$(cat "${cidfile}")
        if [[ ! ${container_id} =~ ^[a-f0-9]{64}$ ]] || ! timeout --signal=TERM --kill-after=2 10 \
            docker rm --force "${container_id}" >/dev/null 2>&1; then
            printf '%s\n' 'Owned stock container cleanup is unconfirmed.' >&2
            return 125
        fi
        unlink "${cidfile}"
    elif [[ ${stock_attempted} == true ]]; then
        if ! remaining=$(timeout --signal=TERM --kill-after=2 10 docker ps --all --no-trunc \
            --filter "label=project.stock.run=${run_id}" --format '{{.ID}}' 2>/dev/null) || [[ -n ${remaining} ]]; then
            printf '%s\n' 'Owned stock container absence is unconfirmed.' >&2
            return 125
        fi
    fi
    stock_attempted=false
}

stock_cleanup() {
    local result=$?
    trap - EXIT INT TERM HUP
    if stock_remove_container; then
        find "${scratch}" -depth -delete
    else
        printf 'Preserve stock check scratch until the owned container is absent: %s\n' "${scratch}" >&2
        result=125
    fi
    exit "${result}"
}

stock_begin() {
    checkout=$1
    if [[ $(sha256sum "${stock_library_path}" | cut -d ' ' -f1) != "${stock_library_hash}" || ( -n ${stock_entrypoint_path:-} && $(sha256sum "${stock_entrypoint_path}" | cut -d ' ' -f1) != "${stock_entrypoint_hash:-}" ) ]]; then
        printf '%s\n' 'Stock control source changed before snapshot capture.' >&2
        return 125
    fi
    git_metadata=(git --no-optional-locks -c core.fsmonitor=false -c core.hooksPath=/dev/null)
    marker_path=$("${git_metadata[@]}" -C "${checkout}" rev-parse --path-format=absolute --git-path container-exec-active)
    if [[ -e ${marker_path} || -L ${marker_path} ]]; then
        printf 'Writable container execution is active or unconfirmed: %s\n' "${marker_path}" >&2
        return 125
    fi
    limit=${CHECK_TIMEOUT_SECONDS:-900}
    if [[ ! ${limit} =~ ^[1-9][0-9]*$ ]]; then printf '%s\n' 'CHECK_TIMEOUT_SECONDS must be a positive integer.' >&2; return 2; fi
    scratch_size=${CHECK_SCRATCH_SIZE:-1g}
    work_size=${CHECK_WORK_SIZE:-2g}
    tmp_size=${CHECK_TMP_SIZE:-1g}
    memory_limit=${CHECK_MEMORY:-4g}
    for size in "${scratch_size}" "${work_size}" "${tmp_size}" "${memory_limit}"; do
        if [[ ! ${size} =~ ^[1-9][0-9]*[kKmMgG]?$ ]]; then printf 'Invalid stock scratch size: %s\n' "${size}" >&2; return 2; fi
    done
    scratch=$(mktemp -d "${TMPDIR:-/tmp}/project-stock.XXXXXXXX")
    cidfile=${scratch}/container.id
    run_id=${scratch##*/}
    stock_attempted=false
    outputs=()
    declare -gA stock_images=()
    declare -gA stock_dependency_images=()
    trap stock_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    local initial_status final_status final_revision
    initial_status=$("${git_metadata[@]}" -C "${checkout}" status --porcelain=v1 --untracked-files=all)
    revision=$("${git_metadata[@]}" -C "${checkout}" rev-parse HEAD)
    source_epoch=$("${git_metadata[@]}" -C "${checkout}" show -s --format=%ct HEAD)
    source_dirty=false
    if [[ -n ${initial_status} ]]; then source_dirty=true; fi
    snapshot "${scratch}/source.tar"
    stock_validate_source "${scratch}/source.tar"
    source_hash=$(sha256sum "${scratch}/source.tar" | cut -d ' ' -f1)
    snapshot "${scratch}/confirmed.tar"
    if [[ $(sha256sum "${scratch}/confirmed.tar" | cut -d ' ' -f1) != "${source_hash}" || $(sha256sum "${stock_library_path}" | cut -d ' ' -f1) != "${stock_library_hash}" || ( -n ${stock_entrypoint_path:-} && $(sha256sum "${stock_entrypoint_path}" | cut -d ' ' -f1) != "${stock_entrypoint_hash:-}" ) ]]; then
        printf '%s\n' 'Stock source or control files changed while capturing the snapshot.' >&2
        return 125
    fi
    final_status=$("${git_metadata[@]}" -C "${checkout}" status --porcelain=v1 --untracked-files=all)
    final_revision=$("${git_metadata[@]}" -C "${checkout}" rev-parse HEAD)
    if [[ ${initial_status} != "${final_status}" || ${revision} != "${final_revision}" ]]; then
        printf '%s\n' 'Source changed while capturing the stock snapshot.' >&2
        return 125
    fi
    before=$(
        if [[ -n ${initial_status} ]]; then printf '%s\n' "${initial_status}"; fi
        printf '%s\n%s\n' "${revision}" "${source_hash}"
    )
}

stock_image() {
    local stock_variable=$1 stock_reference=$2 stock_resolved
    if [[ ! ${stock_variable} =~ ^[A-Za-z_][A-Za-z0-9_]*$ || ! ${stock_reference} =~ ^[a-zA-Z0-9][a-zA-Z0-9./:@_-]*$ ]]; then
        printf '%s\n' 'Invalid private stock image reference.' >&2
        return 2
    fi
    stock_resolved=${stock_images[${stock_reference}]:-}
    if [[ -z ${stock_resolved} ]]; then
        if ! stock_resolved=$(timeout --signal=TERM --kill-after=2 30 docker image inspect --format '{{.Id}}' "${stock_reference}" 2>/dev/null); then
            timeout --signal=TERM --kill-after=10 "${limit}" docker pull "${stock_reference}" >&2
            stock_resolved=$(timeout --signal=TERM --kill-after=2 30 docker image inspect --format '{{.Id}}' "${stock_reference}")
        fi
        if [[ ! ${stock_resolved} =~ ^sha256:[a-f0-9]{64}$ ]]; then printf '%s\n' 'Stock image did not resolve to an immutable image ID.' >&2; return 2; fi
        stock_images[${stock_reference}]=${stock_resolved}
    fi
    printf -v "${stock_variable}" '%s' "${stock_resolved}"
}

stock_container() {
    local network=$1 image=$2 dependency=$3 exporting=$4 status
    shift 4
    mounts=(--mount "type=bind,source=${scratch}/source.tar,target=/source.tar,readonly")
    if [[ -n ${dependency} ]]; then
        if [[ ${stock_dependency_images[${dependency}]:-} != "${image}" ]]; then printf '%s\n' 'Stock dependency and check image IDs differ.' >&2; return 2; fi
        mounts+=(--mount "type=bind,source=${scratch}/dependencies-${dependency}.tar,target=/dependencies.tar,readonly")
    fi
    stock_attempted=true
    set +e
    # The fixed shell program only prepares disposable filesystems and executes literal argv.
    # shellcheck disable=SC2016
    timeout --signal=TERM --kill-after=10 "${limit}" docker run \
        --cidfile "${cidfile}" --label "project.stock.run=${run_id}" --user 19001:19001 \
        --cpus 4 --memory "${memory_limit}" --ulimit nofile=256:256 --pids-limit 512 \
        --read-only --cap-drop ALL --security-opt no-new-privileges --network "${network}" \
        "${mounts[@]}" --tmpfs "/work:rw,exec,nosuid,size=${work_size},uid=19001,gid=19001,mode=1777" \
        --tmpfs "/scratch:rw,exec,nosuid,size=${scratch_size},mode=1777" \
        --tmpfs "/tmp:rw,exec,nosuid,size=${tmp_size},mode=1777" \
        --env HOME=/tmp --env TMPDIR=/scratch --env PYTHONPYCACHEPREFIX=/scratch/pycache --env RUFF_CACHE_DIR=/scratch/ruff \
        --env "CHECK_REVISION=${revision}" --env "CHECK_SOURCE_SHA256=${source_hash}" --env "CHECK_SOURCE_DIRTY=${source_dirty}" \
        --env "SOURCE_DATE_EPOCH=${source_epoch}" --env "CHECK_EXPORT=${exporting}" \
        --workdir /work --entrypoint /bin/sh "${image}" -ec '
            tar --extract --file /source.tar --directory /work --no-same-owner
            if [ -f /dependencies.tar ]; then tar --extract --file /dependencies.tar --directory /scratch --strip-components=1 --no-same-owner; fi
            count=$1
            shift
            if [ "$CHECK_EXPORT" = 1 ]; then
                native() {
                    remaining=$1
                    shift
                    while [ "$remaining" -gt 0 ]; do shift; remaining=$((remaining - 1)); done
                    "$@"
                }
                native "$count" "$@" >&2
                : > /scratch/output.list
                while [ "$count" -gt 0 ]; do
                    output=$1
                    shift
                    count=$((count - 1))
                    case "$(realpath -e "$output")" in /work/*) ;; *) printf "Build output escapes work directory: %s\n" "$output" >&2; exit 2 ;; esac
                    if [ -n "$(find "$output" ! -type f ! -type d -print -quit)" ]; then printf "Build output is not regular: %s\n" "$output" >&2; exit 2; fi
                    printf "%s\0" "$output" >> /scratch/output.list
                done
                tar --create --file - --null --verbatim-files-from --files-from /scratch/output.list
            else
                while [ "$count" -gt 0 ]; do shift; count=$((count - 1)); done
                exec "$@"
            fi
        ' sh "${#outputs[@]}" "${outputs[@]}" "$@"
    status=$?
    set -e
    stock_remove_container
    return "${status}"
}

stock_validate_dependencies() {
    # Inspect archive headers only; dependency payloads are restored exclusively inside containers.
    python3 - "$1" <<'PYARCHIVE'
import posixpath
import re
import sys
import tarfile
from pathlib import PurePosixPath

try:
    with tarfile.open(sys.argv[1], "r:") as archive:
        members = {}
        logical_size = 0
        for member in archive:
            logical_size += member.size
            if member.issparse() or logical_size > 1024**3:
                raise ValueError
            name = member.name.rstrip("/")
            if name != posixpath.normpath(name):
                raise ValueError
            parts = PurePosixPath(name).parts
            if not name.startswith("scratch/") or len(parts) < 2 or parts[0] != "scratch" or any(part in {".", ".."} for part in parts):
                raise ValueError
            if name.startswith("/") or "//" in name or name in members or member.mode & 0o6000:
                raise ValueError
            if not (member.isfile() or member.isdir() or member.issym() or member.islnk()):
                raise ValueError
            if member.issym():
                target = member.linkname
                if target.startswith("/"):
                    if not re.fullmatch(r"/usr/local/bin/python(?:[0-9]+(?:\.[0-9]+)*)?", target):
                        raise ValueError
                elif not posixpath.normpath(posixpath.join(posixpath.dirname(name), target)).startswith("scratch/"):
                    raise ValueError
            elif member.islnk():
                if member.linkname != posixpath.normpath(member.linkname) or not member.linkname.startswith("scratch/") or ".." in PurePosixPath(member.linkname).parts:
                    raise ValueError
            members[name] = member
        for name, member in members.items():
            if any(str(parent) in members and members[str(parent)].issym() for parent in PurePosixPath(name).parents):
                raise ValueError
            if member.islnk():
                target = members.get(member.linkname)
                if target is None or not target.isfile():
                    raise ValueError
except (OSError, ValueError, tarfile.TarError):
    raise SystemExit("Stock dependency archive contains an unsafe path, link or type") from None
PYARCHIVE
}

stock_capture() (
    local destination=$1
    shift
    # A bounded host file prevents sparse archives and setup stdout exhausting host storage.
    ulimit -f 1048576
    "$@" > "${destination}"
)

stock_validate_source() {
    python3 - "$1" <<'PYSOURCE'
import posixpath
import sys
import tarfile
from pathlib import PurePosixPath

try:
    with tarfile.open(sys.argv[1], "r:") as archive:
        members = {}
        logical_size = 0
        for member in archive:
            logical_size += member.size
            if member.issparse() or logical_size > 1024**3:
                raise ValueError
            name = member.name.rstrip("/")
            if not name or name != posixpath.normpath(name) or name.startswith("/") or name == "." or ".." in PurePosixPath(name).parts:
                raise ValueError
            if name in members or not (member.isfile() or member.isdir() or member.issym()) or member.mode & 0o6000:
                raise ValueError
            members[name] = member
        for name, member in members.items():
            if any(str(parent) in members and not members[str(parent)].isdir() for parent in PurePosixPath(name).parents):
                raise ValueError
            if member.issym():
                visited = {name}
                target = name
                while members.get(target) is not None and members[target].issym():
                    link = members[target].linkname
                    if link.startswith("/"):
                        raise ValueError
                    target = posixpath.normpath(posixpath.join(posixpath.dirname(target), link))
                    if target in visited or target == ".." or target.startswith("../"):
                        raise ValueError
                    visited.add(target)
                if target not in members and not any(candidate.startswith(target + "/") for candidate in members):
                    raise ValueError
except (OSError, ValueError, tarfile.TarError):
    raise SystemExit("Stock source archive contains an unsafe path, link or type") from None
PYSOURCE
}

stock_prepare() {
    local image=$1 dependency=$2
    shift 2
    if [[ ${1:-} != -- || ! ${dependency} =~ ^[a-zA-Z0-9_-]+$ ]]; then printf '%s\n' 'Invalid private stock dependency setup.' >&2; return 2; fi
    shift
    stock_attempted=true
    stock_capture "${scratch}/dependencies-${dependency}.tar" stock_container bridge "${image}" '' 0 "$@"
    stock_validate_dependencies "${scratch}/dependencies-${dependency}.tar"
    chmod 0644 "${scratch}/dependencies-${dependency}.tar"
    stock_dependency_images[${dependency}]=${image}
}

stock_run() {
    local image=$1 dependency=$2
    shift 2
    if [[ ${1:-} != -- ]]; then printf '%s\n' 'Invalid private stock execution.' >&2; return 2; fi
    shift
    if (( ${#outputs[@]} )); then
        local -A selected_outputs=()
        for output in "${outputs[@]}"; do
            if [[ -n ${selected_outputs[${output}]:-} ]]; then printf '%s\n' 'Duplicate build output path.' >&2; return 2; fi
            selected_outputs[${output}]=1
            for other in "${outputs[@]}"; do
                if [[ ${output} != "${other}" && ( ${output} == "${other}/"* || ${other} == "${output}/"* ) ]]; then
                    printf '%s\n' 'Build output paths overlap.' >&2
                    return 2
                fi
            done
            if excluded "${output}"; then printf 'Invalid build output path: %s\n' "${output}" >&2; exit 2; fi
            IFS=/ read -r -a components <<< "${output}"
            for component in "${components[@]}"; do
                if [[ -z ${component} || ${component} == . || ${component} == .. ]]; then printf 'Invalid build output path: %s\n' "${output}" >&2; exit 2; fi
            done
        done
        stock_attempted=true
        stock_capture "${scratch}/artifacts.tar" stock_container none "${image}" "${dependency}" 1 "$@"
    else
        stock_container none "${image}" "${dependency}" 0 "$@"
    fi
}

stock_readonly() {
    local image=$1 entrypoint=$2 status
    shift 2
    if [[ ! -d ${scratch}/readonly-source ]]; then
        stock_validate_source "${scratch}/source.tar"
        mkdir "${scratch}/readonly-source"
        tar --extract --file "${scratch}/source.tar" --directory "${scratch}/readonly-source" --no-same-owner
        find "${scratch}/readonly-source" -type d -exec chmod a+rx {} +
        find "${scratch}/readonly-source" -type f -exec chmod a+r {} +
    fi
    stock_attempted=true
    set +e
    timeout --signal=TERM --kill-after=10 "${limit}" docker run \
        --cidfile "${cidfile}" --label "project.stock.run=${run_id}" --user 19001:19001 \
        --cpus 4 --memory "${memory_limit}" --ulimit nofile=256:256 --pids-limit 512 \
        --read-only --cap-drop ALL --security-opt no-new-privileges --network none \
        --mount "type=bind,source=${scratch}/readonly-source,target=/work,readonly" \
        --tmpfs "/scratch:rw,exec,nosuid,size=${scratch_size},mode=1777" \
        --tmpfs "/tmp:rw,exec,nosuid,size=${tmp_size},mode=1777" \
        --env HOME=/tmp --env TMPDIR=/scratch \
        --env "CHECK_REVISION=${revision}" --env "CHECK_SOURCE_SHA256=${source_hash}" --env "CHECK_SOURCE_DIRTY=${source_dirty}" \
        --env "SOURCE_DATE_EPOCH=${source_epoch}" --workdir /work --entrypoint "${entrypoint}" "${image}" "$@"
    status=$?
    set -e
    stock_remove_container
    return "${status}"
}

stock_validate_outputs() {
    python3 - "$@" <<'PYOUTPUT'
import posixpath
import sys
import tarfile
from pathlib import PurePosixPath

try:
    with tarfile.open(sys.argv[1], "r:") as archive:
        members = {}
        logical_size = 0
        roots = sys.argv[2:]
        for member in archive:
            logical_size += member.size
            if member.issparse() or logical_size > 1024**3:
                raise ValueError
            name = member.name.rstrip("/")
            if not name or name != posixpath.normpath(name) or name.startswith("/") or name == "." or ".." in PurePosixPath(name).parts:
                raise ValueError
            if name in members or not any(name == root or name.startswith(root + "/") for root in roots):
                raise ValueError
            if not (member.isfile() or member.isdir()) or member.mode & 0o6000:
                raise ValueError
            members[name] = member
        for name in members:
            if any(str(parent) in members and not members[str(parent)].isdir() for parent in PurePosixPath(name).parents):
                raise ValueError
        if not all(root in members for root in roots):
            raise ValueError
except (OSError, ValueError, tarfile.TarError):
    raise SystemExit("Stock output archive contains an unsafe path or type") from None
PYOUTPUT
}

stock_finish() {
    local after
    if [[ -e ${marker_path} || -L ${marker_path} ]]; then printf '%s\n' 'Source has active writable execution.' >&2; return 125; fi
    snapshot "${scratch}/after.tar"
    after=$("${git_metadata[@]}" -C "${checkout}" status --porcelain=v1 --untracked-files=all; "${git_metadata[@]}" -C "${checkout}" rev-parse HEAD; sha256sum "${scratch}/after.tar" | cut -d ' ' -f1)
    if [[ ${before} != "${after}" ]]; then printf '%s\n' 'Discarding stock check result: source changed during verification.' >&2; return 125; fi
    if (( ${#outputs[@]} )); then
        stock_validate_outputs "${scratch}/artifacts.tar" "${outputs[@]}"
        mkdir "${scratch}/outputs"
        tar --extract --file "${scratch}/artifacts.tar" --directory "${scratch}/outputs" --no-same-owner
        publish_outputs
    fi
}

excluded() {
    case "${1,,}" in
        /*|..|../*|*/../*|*/..|.git|.git/*|*/.git|*/.git/*) return 0 ;;
        agents.md|*/agents.md|claude.md|*/claude.md|claude.local.md|*/claude.local.md|gemini.md|*/gemini.md) return 0 ;;
        .env|.env.*|*/.env|*/.env.*|*.env|.dev.vars|.dev.vars.*|*/.dev.vars|*/.dev.vars.*) return 0 ;;
        .npmrc|*/.npmrc|.pypirc|*/.pypirc|.netrc|*/.netrc|.git-credentials|*/.git-credentials|.private/*|*/.private/*|.ssh/*|*/.ssh/*|.aws/*|*/.aws/*) return 0 ;;
        credentials|credentials.*|*/credentials|*/credentials.*|*.pem|*.key|*.crt|*.cer|*.p12|*.pfx|*.age|*.gpg|*.sops.*) return 0 ;;
    esac
    return 1
}
contained() {
    local path=$1 resolved relative
    resolved=$(realpath -m -- "${checkout}/$(dirname -- "${path}")")
    case "${resolved}" in
        "${checkout}"|"${checkout}"/*) ;;
        *) printf 'Source path escapes checkout: %s\n' "${path}" >&2; return 2 ;;
    esac
    if [[ ${resolved} == "${checkout}" ]]; then
        relative=$(basename -- "${path}")
    else
        relative=${resolved#"${checkout}/"}
        if excluded "${relative}" || excluded "${relative}/"; then
            printf 'Source parent resolves to an excluded location: %s\n' "${path}" >&2
            return 2
        fi
        relative+=/$(basename -- "${path}")
    fi
    if excluded "${relative}"; then printf 'Source path resolves to an excluded location: %s\n' "${path}" >&2; return 2; fi
}
collect_source() {
    local root=$1 prefix=$2 path relative entries
    entries=${scratch}/git-files-$(printf '%s' "${root}" | sha256sum | cut -c1-16)
    "${git_metadata[@]}" -C "${root}" ls-files --cached --others --exclude-standard -z > "${entries}"
    while IFS= read -r -d '' path; do
        relative=${prefix}${path}
        if excluded "${relative}"; then continue; fi
        contained "${relative}"
        if [[ -d ${root}/${path} && ! -L ${root}/${path} ]]; then
            if [[ -e ${root}/${path}/.git ]]; then
                collect_source "${root}/${path}" "${relative}/"
            elif [[ $("${git_metadata[@]}" --literal-pathspecs -C "${root}" ls-files --format='%(objectmode)' -- "${path}") == 160000 ]]; then
                printf '%s\0' "${relative}"
            fi
        elif [[ -e ${root}/${path} || -L ${root}/${path} ]]; then
            printf '%s\0' "${relative}"
        fi
    done < "${entries}"
}
snapshot() {
    local output=$1
    collect_source "${checkout}" '' > "${scratch}/source.list"
    (ulimit -f 1048576; tar --create --file "${output}" --directory "${checkout}" \
        --null --verbatim-files-from --no-recursion --files-from "${scratch}/source.list")
    chmod 0644 "${output}"
}
publish_outputs() (
    areas=()
    destinations=()
    names=()
    # The publication subshell invokes this callback through its EXIT trap.
    # shellcheck disable=SC2329
    cleanup_publish() {
        status=$?
        trap - EXIT
        for area in "${areas[@]}"; do
            if [[ -e ${area}/previous || -L ${area}/previous ]]; then
                printf 'Prior generated output is preserved at %s.\n' "${area}/previous" >&2
                status=2
            else
                find "${area}" -depth -delete || status=2
            fi
        done
        exit "${status}"
    }
    trap cleanup_publish EXIT
    validate_tree() {
        local prefix=$1 tree=$2 entry relative
        find "${tree}" -print0 > "${scratch}/export.list"
        while IFS= read -r -d '' entry; do
            relative=${prefix}${entry#"${tree}"}
            if [[ -L ${entry} || ( ! -f ${entry} && ! -d ${entry} ) ]]; then
                printf 'Build output is not a regular file or directory: %s\n' "${relative}" >&2
                return 2
            fi
            if excluded "${relative}" || excluded "${relative}/"; then
                printf 'Build output contains an excluded entry: %s\n' "${relative}" >&2
                return 2
            fi
        done < "${scratch}/export.list"
    }
    validate_destination() {
        local stage=$1 output=$2 destination=${checkout} component tracked indexed candidate
        if [[ -e ${marker_path} || -L ${marker_path} ]]; then
            printf 'Source has active writable execution: %s\n' "${marker_path}" >&2
            return 125
        fi
        IFS=/ read -r -a components <<< "${output}"
        for component in "${components[@]}"; do
            destination+=/${component}
            if [[ -L ${destination} ]]; then printf 'Build destination is a symlink: %s\n' "${output}" >&2; return 2; fi
        done
        indexed=$("${git_metadata[@]}" --literal-pathspecs -C "${checkout}" ls-files -- "${output}")
        tracked=$("${git_metadata[@]}" --literal-pathspecs -C "${checkout}" ls-tree -r --name-only HEAD -- "${output}")
        if [[ -n ${indexed} || -n ${tracked} ]]; then
            printf 'Build output contains tracked source: %s\n' "${output}" >&2
            return 2
        fi
        candidate=${output}
        if [[ -d ${stage} ]]; then candidate+=/; fi
        if ! "${git_metadata[@]}" -C "${checkout}" check-ignore --quiet --no-index -- "${candidate}"; then
            printf 'Build output must be Git-ignored generated content: %s\n' "${output}" >&2
            return 2
        fi
        if [[ -e ${destination} ]]; then
            if [[ ( -d ${stage} && ! -d ${destination} ) || ( -f ${stage} && ! -f ${destination} ) ]]; then
                printf 'Build output changes an existing path type: %s\n' "${output}" >&2
                return 2
            fi
            validate_tree "${output}" "${destination}"
        fi
    }
    for output in "${outputs[@]}"; do
        while [[ ${output} == */ ]]; do output=${output%/}; done
        stage=${scratch}/outputs/${output}
        validate_tree "${output}" "${stage}"
        validate_destination "${stage}" "${output}"
        destination=${checkout}/${output}
        mkdir -p "$(dirname -- "${destination}")"
        area=$(mktemp -d "$(dirname -- "${destination}")/.check-output.XXXXXXXX")
        areas+=("${area}")
        destinations+=("${destination}")
        names+=("${output}")
        printf 'CLEANUP (added %s): Remove after prior generated output is restored or reviewed.\n' "$(date -u +%F)" > "${area}/CLEANUP"
        if [[ -d ${stage} ]]; then
            mkdir "${area}/new"
            cp -R --no-preserve=ownership "${stage}/." "${area}/new/"
        else
            cp --no-preserve=ownership "${stage}" "${area}/new"
        fi
    done
    for index in "${!areas[@]}"; do
        area=${areas[${index}]}
        destination=${destinations[${index}]}
        output=${names[${index}]}
        validate_destination "${area}/new" "${output}"
        if [[ -e ${destination} ]]; then mv -T -- "${destination}" "${area}/previous"; fi
        if ! mv -T -- "${area}/new" "${destination}"; then
            if [[ -e ${area}/previous && ! -e ${destination} && ! -L ${destination} ]]; then
                mv -T -- "${area}/previous" "${destination}"
            fi
            exit 2
        fi
        if [[ -e ${area}/previous ]]; then
            validate_tree "${output}" "${area}/previous"
            find "${area}/previous" -depth -delete
        fi
    done
)
