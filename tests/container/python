#!/bin/sh
set -eu
export VIRTUAL_ENV=/scratch/venv PATH="/scratch/venv/bin:$PATH"
export POETRY_VIRTUALENVS_CREATE=false
case "$1" in
    prepare)
        python -m venv /scratch/venv >&2
        /scratch/venv/bin/python -m pip install --disable-pip-version-check poetry==2.5.1 >&2
        poetry install --no-root >&2
        exec tar --create --file - --directory / scratch/venv
        ;;
    check)
        for task in lint build; do sh "$0" "$task"; done
        ;;
    lint)
        for script in tests/container/run tests/container/stock tests/container/check-stock; do bash -n "$script"; done
        for script in tests/container/check tests/container/python tests/container/markdown; do sh -n "$script"; done
        ruff check .
        ruff format --check .
        ;;
    build)
        exec poetry build
        ;;
    *) exit 2 ;;
esac
